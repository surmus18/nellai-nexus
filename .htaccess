# Nellai Nexus Apache Configuration
# Hide .html extension & enforce clean URLs for all pages

Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2. Redirect any request ending in .html to clean URL (e.g. /about.html -> /about)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html\ HTTP/ [NC]
RewriteRule ^([^\ ]+)\.html$ /$1 [R=301,L]

# 3. Direct /services to services.html (handles directory collision)
RewriteRule ^services/?$ services.html [L]

# 4. Rewrite /services/{slug} to services/{slug}.html
RewriteCond %{DOCUMENT_ROOT}/services/$1.html -f [OR]
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ services/$1.html [L]

# 5. Internally rewrite clean URLs to .html (e.g. /about -> about.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L]

# Performance Caching Headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
